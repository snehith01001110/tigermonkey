{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tigermonkey-multiplayer",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://tigermonkey.com,https://www.tigermonkey.com,https://snehith01001110.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
